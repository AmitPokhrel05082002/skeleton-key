{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/REPLACE_ME/schema/app-definition.schema.json",
  "title": "App Definition",
  "description": "One JSON document describes a whole app: roles, entities, forms, views and workflows. Structural rules live here; cross-reference rules (codes exist, steps reachable, joins match) are enforced by the publish-time validator.",
  "type": "object",
  "required": ["schemaVersion", "app", "roles", "entities", "workflows"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": 1 },
    "app": { "$ref": "#/$defs/app" },
    "roles": {
      "type": "array", "minItems": 1,
      "items": { "$ref": "#/$defs/role" }
    },
    "entities": {
      "type": "array", "minItems": 1,
      "items": { "$ref": "#/$defs/entity" }
    },
    "forms": {
      "type": "array",
      "items": { "$ref": "#/$defs/form" }
    },
    "views": {
      "type": "array",
      "items": { "$ref": "#/$defs/view" }
    },
    "workflows": {
      "type": "array", "minItems": 1,
      "items": { "$ref": "#/$defs/workflow" }
    }
  },

  "$defs": {
    "code": {
      "description": "Stable machine identifier. Upper snake case for app-level codes.",
      "type": "string", "pattern": "^[A-Z][A-Z0-9_]{0,63}$"
    },
    "fieldCode": {
      "description": "Field identifier, used as the JSONB key and in expressions.",
      "type": "string", "pattern": "^[a-z][a-zA-Z0-9_]{0,63}$"
    },
    "label": { "type": "string", "minLength": 1, "maxLength": 120 },
    "expression": {
      "description": "JSONLogic expression evaluated against { data, instance, user }. A bare boolean is allowed for constants.",
      "type": ["object", "boolean"]
    },

    "app": {
      "type": "object",
      "required": ["code", "name"],
      "additionalProperties": false,
      "properties": {
        "code": { "$ref": "#/$defs/code" },
        "name": { "$ref": "#/$defs/label" },
        "description": { "type": "string", "maxLength": 500 },
        "branding": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "primaryColor": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
            "logo": { "type": "string", "description": "Path or URL of the logo image." },
            "theme": { "enum": ["light", "dark", "auto"] }
          }
        }
      }
    },

    "role": {
      "type": "object",
      "required": ["code", "label"],
      "additionalProperties": false,
      "properties": {
        "code": { "$ref": "#/$defs/code" },
        "label": { "$ref": "#/$defs/label" },
        "public": {
          "type": "boolean", "default": false,
          "description": "True for the anonymous role used by public forms. At most one role may be public."
        }
      }
    },

    "entity": {
      "type": "object",
      "required": ["code", "label", "fields"],
      "additionalProperties": false,
      "properties": {
        "code": { "$ref": "#/$defs/code" },
        "label": { "$ref": "#/$defs/label" },
        "titleField": { "$ref": "#/$defs/fieldCode", "description": "Field shown as the record title in lists and cards." },
        "referencePrefix": {
          "type": "string", "pattern": "^[A-Z]{2,6}$",
          "description": "Human-readable record number prefix, e.g. GRV produces GRV-2026-000123."
        },
        "fields": {
          "type": "array", "minItems": 1,
          "items": { "$ref": "#/$defs/field" }
        }
      }
    },

    "field": {
      "type": "object",
      "required": ["code", "label", "type"],
      "additionalProperties": false,
      "properties": {
        "code": { "$ref": "#/$defs/fieldCode" },
        "label": { "$ref": "#/$defs/label" },
        "type": {
          "enum": ["TEXT", "TEXTAREA", "NUMBER", "DECIMAL", "DATE", "DATETIME", "BOOLEAN",
                   "SELECT", "MULTISELECT", "FILE", "USER", "REFERENCE", "EMAIL", "PHONE", "LOCATION"]
        },
        "required": { "type": "boolean", "default": false, "description": "Required on create. Step field rules can tighten this later." },
        "help": { "type": "string", "maxLength": 300 },
        "default": {},
        "options": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object",
            "required": ["value", "label"],
            "additionalProperties": false,
            "properties": {
              "value": { "type": "string" },
              "label": { "$ref": "#/$defs/label" }
            }
          }
        },
        "ref": { "$ref": "#/$defs/code", "description": "Target entity code for REFERENCE fields." },
        "min": { "type": "number" },
        "max": { "type": "number" },
        "maxLength": { "type": "integer", "minimum": 1 },
        "pattern": { "type": "string", "description": "Regex for TEXT fields." },
        "accept": { "type": "string", "description": "Accepted MIME types for FILE fields, e.g. image/*,application/pdf." },
        "maxFiles": { "type": "integer", "minimum": 1 }
      },
      "allOf": [
        { "if": { "properties": { "type": { "enum": ["SELECT", "MULTISELECT"] } } }, "then": { "required": ["options"] } },
        { "if": { "properties": { "type": { "const": "REFERENCE" } } }, "then": { "required": ["ref"] } }
      ]
    },

    "form": {
      "type": "object",
      "required": ["code", "entity", "sections"],
      "additionalProperties": false,
      "properties": {
        "code": { "$ref": "#/$defs/code" },
        "label": { "$ref": "#/$defs/label" },
        "entity": { "$ref": "#/$defs/code" },
        "public": { "type": "boolean", "default": false, "description": "Reachable without login by the public role." },
        "roles": { "type": "array", "items": { "$ref": "#/$defs/code" }, "description": "Roles allowed to submit. Ignored when public is true." },
        "startsWorkflow": { "$ref": "#/$defs/code", "description": "Workflow started when this form is submitted." },
        "sections": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object",
            "required": ["fields"],
            "additionalProperties": false,
            "properties": {
              "title": { "$ref": "#/$defs/label" },
              "columns": { "enum": [1, 2, 3], "default": 1 },
              "fields": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/fieldCode" } }
            }
          }
        }
      }
    },

    "view": {
      "type": "object",
      "required": ["code", "type", "entity"],
      "additionalProperties": false,
      "properties": {
        "code": { "$ref": "#/$defs/code" },
        "label": { "$ref": "#/$defs/label" },
        "type": { "enum": ["TABLE", "KANBAN", "MY_TASKS"] },
        "entity": { "$ref": "#/$defs/code" },
        "roles": { "type": "array", "items": { "$ref": "#/$defs/code" } },
        "columns": { "type": "array", "items": { "$ref": "#/$defs/columnRef" } },
        "filters": { "type": "array", "items": { "$ref": "#/$defs/columnRef" } },
        "defaultSort": {
          "type": "object",
          "required": ["field"],
          "additionalProperties": false,
          "properties": {
            "field": { "$ref": "#/$defs/columnRef" },
            "direction": { "enum": ["ASC", "DESC"], "default": "DESC" }
          }
        },
        "scope": {
          "enum": ["ALL", "MINE", "ASSIGNED_TO_ME", "MY_ROLE_QUEUE"], "default": "ALL",
          "description": "Row-level filter applied server-side."
        }
      }
    },
    "columnRef": {
      "description": "An entity field code, or a system column prefixed with $.",
      "type": "string",
      "pattern": "^([a-z][a-zA-Z0-9_]{0,63}|\\$(reference|status|step|assignee|createdAt|updatedAt|dueAt|createdBy))$"
    },

    "workflow": {
      "type": "object",
      "required": ["code", "version", "entity", "startStep", "statuses", "steps"],
      "additionalProperties": false,
      "properties": {
        "code": { "$ref": "#/$defs/code" },
        "version": { "type": "integer", "minimum": 1 },
        "label": { "$ref": "#/$defs/label" },
        "entity": { "$ref": "#/$defs/code" },
        "startStep": { "$ref": "#/$defs/code" },
        "initialStatus": { "$ref": "#/$defs/label", "description": "Status label set on start. Defaults to the first OPEN status." },
        "statuses": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object",
            "required": ["label", "category"],
            "additionalProperties": false,
            "properties": {
              "label": { "$ref": "#/$defs/label" },
              "category": { "enum": ["OPEN", "IN_PROGRESS", "DONE", "REJECTED"] },
              "color": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" }
            }
          }
        },
        "steps": {
          "type": "array", "minItems": 2,
          "items": { "$ref": "#/$defs/step" }
        },
        "transitions": {
          "type": "array",
          "items": { "$ref": "#/$defs/transition" }
        }
      }
    },

    "step": {
      "type": "object",
      "required": ["code", "type"],
      "additionalProperties": false,
      "properties": {
        "code": { "$ref": "#/$defs/code" },
        "label": { "$ref": "#/$defs/label" },
        "type": { "enum": ["TASK", "APPROVAL", "AUTO", "PARALLEL", "JOIN", "SUBWORKFLOW", "END"] },
        "assignee": { "$ref": "#/$defs/assignee" },
        "skipWhen": { "$ref": "#/$defs/expression", "description": "Evaluated on entry. If true the step is recorded as skipped and routing continues." },
        "slaHours": { "type": "number", "exclusiveMinimum": 0 },
        "remindBeforeHours": { "type": "number", "exclusiveMinimum": 0, "description": "Reminder to the assignee this many hours before the SLA is due." },
        "escalateTo": { "$ref": "#/$defs/code", "description": "Role that is notified and gains the task when the SLA is breached." },
        "fields": {
          "type": "object",
          "description": "Per-step field rules. Fields not listed are read-only.",
          "propertyNames": { "$ref": "#/$defs/fieldCode" },
          "additionalProperties": { "enum": ["hidden", "readonly", "optional", "required"] }
        },
        "actions": { "type": "array", "items": { "$ref": "#/$defs/action" } },
        "onEnter": { "type": "array", "items": { "$ref": "#/$defs/event" } },
        "onExit": { "type": "array", "items": { "$ref": "#/$defs/event" } },
        "branches": {
          "type": "array", "minItems": 2, "items": { "$ref": "#/$defs/code" },
          "description": "PARALLEL only: steps opened at the same time."
        },
        "join": { "$ref": "#/$defs/code", "description": "PARALLEL only: the JOIN step that closes this group." },
        "mode": { "enum": ["ALL", "ANY"], "description": "JOIN only: continue when all branches, or the first branch, finish." },
        "workflow": { "$ref": "#/$defs/code", "description": "SUBWORKFLOW only: child workflow started on entry. The parent waits until it ends." },
        "copyFields": {
          "type": "array", "items": { "$ref": "#/$defs/fieldCode" },
          "description": "SUBWORKFLOW only: fields copied from parent data into the child record."
        },
        "handler": { "type": "string", "pattern": "^[a-zA-Z][a-zA-Z0-9]*$", "description": "AUTO only: plugin bean name run on entry before routing on." },
        "outcome": { "$ref": "#/$defs/label", "description": "END only: final status label." }
      },
      "allOf": [
        { "if": { "properties": { "type": { "enum": ["TASK", "APPROVAL"] } } }, "then": { "required": ["assignee", "actions"] } },
        { "if": { "properties": { "type": { "const": "PARALLEL" } } }, "then": { "required": ["branches", "join"] } },
        { "if": { "properties": { "type": { "const": "JOIN" } } }, "then": { "required": ["mode"] } },
        { "if": { "properties": { "type": { "const": "SUBWORKFLOW" } } }, "then": { "required": ["workflow"] } },
        { "if": { "properties": { "type": { "const": "END" } } }, "then": { "required": ["outcome"], "not": { "required": ["actions"] } } }
      ]
    },

    "assignee": {
      "type": "object",
      "required": ["strategy"],
      "additionalProperties": false,
      "properties": {
        "strategy": {
          "enum": ["ROLE_QUEUE", "LEAST_LOADED", "ROUND_ROBIN", "INITIATOR", "FROM_FIELD"],
          "description": "ROLE_QUEUE: anyone with the role can claim. LEAST_LOADED / ROUND_ROBIN: auto-assign within the role. INITIATOR: whoever started the instance. FROM_FIELD: the USER field named in field."
        },
        "role": { "$ref": "#/$defs/code" },
        "field": { "$ref": "#/$defs/fieldCode" }
      },
      "allOf": [
        { "if": { "properties": { "strategy": { "enum": ["ROLE_QUEUE", "LEAST_LOADED", "ROUND_ROBIN"] } } }, "then": { "required": ["role"] } },
        { "if": { "properties": { "strategy": { "const": "FROM_FIELD" } } }, "then": { "required": ["field"] } }
      ]
    },

    "action": {
      "type": "object",
      "required": ["code", "label", "roles"],
      "additionalProperties": false,
      "properties": {
        "code": { "$ref": "#/$defs/code" },
        "label": { "$ref": "#/$defs/label" },
        "roles": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/code" } },
        "to": { "$ref": "#/$defs/code", "description": "Target step if no transition matches." },
        "status": { "$ref": "#/$defs/label", "description": "Status label set when the action runs." },
        "remarks": { "enum": ["hidden", "optional", "required"], "default": "optional" },
        "attachment": { "enum": ["hidden", "optional", "required"], "default": "hidden" },
        "style": { "enum": ["primary", "default", "danger"], "default": "default" },
        "confirm": { "type": "string", "maxLength": 200, "description": "Confirmation prompt shown before the action runs." },
        "when": { "$ref": "#/$defs/expression", "description": "The button only shows and is only accepted when this is true." },
        "handler": { "type": "string", "pattern": "^[a-zA-Z][a-zA-Z0-9]*$", "description": "Plugin bean run after validation and before routing." }
      }
    },

    "transition": {
      "type": "object",
      "required": ["from", "to"],
      "additionalProperties": false,
      "properties": {
        "from": { "$ref": "#/$defs/code" },
        "to": { "$ref": "#/$defs/code" },
        "on": { "$ref": "#/$defs/code", "description": "Only applies to this action code. Omit to apply to any action leaving from." },
        "when": { "$ref": "#/$defs/expression" },
        "priority": { "type": "integer", "minimum": 0, "default": 100, "description": "Lower runs first." }
      }
    },

    "event": {
      "type": "object",
      "required": ["do"],
      "properties": {
        "do": { "enum": ["NOTIFY", "SET_FIELD", "WEBHOOK", "HANDLER"] },
        "when": { "$ref": "#/$defs/expression" }
      },
      "oneOf": [
        {
          "properties": {
            "do": { "const": "NOTIFY" },
            "when": true,
            "template": { "type": "string" },
            "to": {
              "type": "array", "minItems": 1,
              "items": { "type": "string", "pattern": "^(INITIATOR|ASSIGNEE|ROLE:[A-Z][A-Z0-9_]*|FIELD:[a-z][a-zA-Z0-9_]*)$" }
            }
          },
          "required": ["do", "template", "to"], "additionalProperties": false
        },
        {
          "properties": {
            "do": { "const": "SET_FIELD" },
            "when": true,
            "field": { "$ref": "#/$defs/fieldCode" },
            "value": { "description": "Literal value, or a JSONLogic expression object." }
          },
          "required": ["do", "field", "value"], "additionalProperties": false
        },
        {
          "properties": {
            "do": { "const": "WEBHOOK" },
            "when": true,
            "url": { "type": "string", "format": "uri", "pattern": "^https://" }
          },
          "required": ["do", "url"], "additionalProperties": false
        },
        {
          "properties": {
            "do": { "const": "HANDLER" },
            "when": true,
            "handler": { "type": "string", "pattern": "^[a-zA-Z][a-zA-Z0-9]*$" }
          },
          "required": ["do", "handler"], "additionalProperties": false
        }
      ]
    }
  }
}
